rules_version = '2';

// The browser never talks to Firestore directly. All reads and writes go through the API on Cloud Run,
// which uses its own service account (IAM, not these rules) and checks ownership and roles itself.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
