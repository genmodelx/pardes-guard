# Copy to .env.local (it is git-ignored) and fill in. These values are public by design: they end
# up in the browser bundle. Security comes from Firebase Authentication and the Firestore rules.
# Never put a service-account key or any other secret in this folder.

# Firebase web app config (Firebase console > Project settings > Your apps > Web app).
# Leave all four empty to build the offline demo: no sign-in, data stays on the device, no Gemini.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Grounding with Google Search and Google Maps on text models is not on the free tier.
# Leave this off unless the project has billing. Off: the app shows plain Search and Maps links.
NEXT_PUBLIC_GROUNDING=off
