{
  "name": "pardes-guard-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/check-stale.mjs",
    "dev": "next dev -p 3000",
    "prebuild": "node scripts/check-stale.mjs",
    "build": "next build",
    "postbuild": "node scripts/build-sw.mjs",
    "preview": "node scripts/serve-out.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "data": "python3 scripts/export_data.py",
    "icons": "node scripts/build-icons.mjs",
    "fonts": "node scripts/copy-fonts.mjs",
    "pattern": "node scripts/build-pattern.mjs",
    "test:rules": "npx --yes firebase-tools@15 emulators:exec --only firestore --project demo-pardes-guard --config ../firebase.json \"vitest run --config vitest.rules.config.mts\"",
    "flags": "node scripts/copy-flags.mjs",
    "brand": "node scripts/build-app-icons.mjs",
    "samples": "node scripts/build-samples.mjs"
  },
  "dependencies": {
    "firebase": "^13.0.0",
    "jszip": "3.10.2",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@firebase/rules-unit-testing": "6.0.0",
    "@fontsource-variable/atkinson-hyperlegible-mono": "5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource-variable/noto-naskh-arabic": "5.3.0",
    "@fontsource-variable/noto-nastaliq-urdu": "5.3.0",
    "@fontsource-variable/noto-sans-bengali": "5.3.0",
    "@fontsource-variable/noto-sans-devanagari": "5.3.0",
    "@fontsource-variable/noto-sans-sinhala": "5.3.0",
    "@fontsource-variable/noto-sans-tamil": "5.3.0",
    "@fontsource-variable/onest": "5.3.1",
    "@phosphor-icons/core": "2.1.1",
    "@playwright/test": "1.56.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "flag-icons": "7.5.0",
    "playwright-core": "1.56.0",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  }
}
