# Copy to backend/.env (git-ignored) for local work. app/config.py reads every value here; a value
# set in the shell wins over this file. Keep comments on their own lines: a comment after an empty
# value would be read as the value.
#
# Which values matter depends on where the API runs:
#   Your computer: the first section. Leave the rest as is.
#   Cloud Run: infra/deploy.sh sets everything there (infra/CLOUD_RUN.md); nothing to copy from here.

# ===== Your computer ==================================================================

# dev = your computer; demo = a public sandbox (real services, nobody signed in); prod = production
ENV=dev
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]

# --- AI ---
# LLM_BACKEND
#   auto   = Gemini when GEMINI_API_KEY is set and Gemini answers; when it does not (no key, out of
#            free quota, no internet) each call takes the offline path: papers are marked "not read",
#            the rules use what the person typed, explanations and letters come from templates.
#   gemini = Gemini only; a failure shows as an error (for debugging).
#   fake   = the test fixtures' reader. Tests only: it cannot read real papers.
LLM_BACKEND=auto
# A Google AI Studio key (aistudio.google.com > Get API key) from a project with no billing, so it
# stays on the free tier. Never commit it.
GEMINI_API_KEY=
# Models with a free tier on the Gemini Developer API (the Pro default has none).
MODEL_FAST=gemini-3.5-flash-lite
MODEL_PRO=gemini-3.8-flash
MODEL_TTS=gemini-3.8-flash-lite-tts
TTS_VOICE=Kore
# After Gemini is out of quota or unreachable: seconds on the offline path before trying it again.
AI_COOLDOWN_SECONDS=60

# --- Storage ---
# memory    = kept in this process and gone on restart (local work)
# firestore = the Firebase project's Firestore; needs GOOGLE_CLOUD_PROJECT and, on your computer,
#             gcloud auth application-default login
STORE_BACKEND=memory
GRAPH_BACKEND=memory
# The Firebase project id (only needed with STORE_BACKEND=firestore)
GOOGLE_CLOUD_PROJECT=
# The API's own Firestore database; a deployed API uses pardes-api (infra/CLOUD_RUN.md)
FIRESTORE_DATABASE=(default)

# --- Sign-in ---
# dev      = X-Dev-User and X-Dev-Role headers. Your computer only: the caller picks its own role.
# demo     = a public sandbox: every caller is a worker, staff routes are closed.
# firebase = Firebase ID tokens; staff roles from a custom claim (python -m app.scripts.set_role).
AUTH_MODE=dev
# Secrets for hashing phone numbers and signing evidence. For anything other people can reach, make
# new ones (on Cloud Run they come from Secret Manager) with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
HASH_SALT=dev-only-salt-change-me
EVIDENCE_SIGNING_KEY=dev-only-signing-key-change-me

# --- Uploads and data (the defaults are fine) ---
MAX_UPLOAD_MB=12
MAX_FILES_PER_REQUEST=8
# Empty = the bundled country packs
PACKS_DIR=
# Empty = the bundled fictional recruiter list; or the path to the official list as CSV
RECRUITERS_CSV=

# ===== Spanner Graph on the local emulator (optional, $0) =============================
# Steps in infra/spanner/README.md. Leave GRAPH_BACKEND=memory above unless you use it.
SPANNER_PROJECT=
SPANNER_INSTANCE=
SPANNER_DATABASE=
SPANNER_EMULATOR_HOST=

# ===== Set by infra/deploy.sh on Cloud Run (leave empty on your computer) ==============
GOOGLE_CLOUD_LOCATION=global
# Uploads bucket; empty keeps uploads in memory
GCS_BUCKET=
# projects/P/locations/L/keyRings/R/cryptoKeys/K/cryptoKeyVersions/1 (empty = local HMAC signing)
KMS_KEY_VERSION=
USE_SENSITIVE_DATA_PROTECTION=false
# projects/P/locations/L/templates/T (empty = the local screen only)
MODEL_ARMOR_TEMPLATE=
# The API's https URL, as set on the Cloud Scheduler OIDC token
SCHEDULER_AUDIENCE=
# scheduler-invoker@P.iam.gserviceaccount.com
SCHEDULER_SERVICE_ACCOUNT=
# A legal-aid partner's A2A agent card; empty = approved hand-offs wait in the outbox
PARTNER_AGENT_CARD_URL=
